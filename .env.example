# Copy to .env for local development. On Cloud Run these are set as env vars / Secret Manager secrets.

# --- Gemini ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key
# On GCP you can skip the API key and use the Cloud Run service account instead:
# GEMINI_USE_VERTEX=true
# GCP_PROJECT=your-project-id
# GCP_LOCATION=europe-west1

# Embeddings for knowledge base search. If you change these, rebuild the index (scripts/create_indices.py).
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768

# --- Gmail API (create with scripts/get_gmail_token.py) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SUPPORT_ADDRESS=your-support-mailbox@gmail.com

# --- Pub/Sub ---
PUBSUB_TOPIC=projects/your-project-id/topics/gmail-notifications
# Leave the two below unset locally. On Cloud Run set the audience to the service URL.
# PUBSUB_OIDC_AUDIENCE=https://alza-email-agent-xxxxx.a.run.app
# PUBSUB_OIDC_SERVICE_ACCOUNT=pubsub-invoker@your-project-id.iam.gserviceaccount.com

# --- Behaviour ---
# draft = save the reply as a Gmail draft for human review (safe default), send = reply to the customer
SEND_MODE=draft
